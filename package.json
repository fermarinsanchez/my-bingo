{
  "name": "my-bingo",
  "version": "1.0.0",
  "private": true,
  "description": "Bombo de bingo de 90 bolas: PWA offline para móvil (es/gl)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-size": "node scripts/check-size.mjs",
    "build:lhci": "BASE_PATH=/ vite build --outDir dist-lhci",
    "lhci": "npm run build:lhci && lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
